# Infrastructure
DATABASE_URL="file:./data/chronos_metamodel.sqlite"
WORKER_THREAD_POOL_SIZE=8
MEMORY_HARD_LIMIT_MB=4096

# Development Mode & Seeded Operators (oblx / analyst_dev / auditor_dev / viewer_dev)
DEVMODE=false

# Analysis Pipeline
DEFAULT_SCAN_DIRECTORY="./src"
MAX_FILE_SIZE_BYTES=5242880
INCREMENTAL_INDEXING_ENABLED=true

# HUD Configuration
HUD_REFRESH_RATE_MS=16
HUD_AUDIO_FEEDBACK_SYNTH=false

# Realtime WebSocket Collaboration Hub (100-Concurrent-User Cap)
WS_ENABLED=true
WS_MAX_CLIENTS=100
WS_HEARTBEAT_INTERVAL_MS=15000
WS_IDLE_TIMEOUT_MS=45000
WS_MAX_PAYLOAD_BYTES=65536
WS_MSG_RATE_LIMIT_PER_SEC=30

# Zero-SDK OAuth2 PKCE Providers (GitHub & Google)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
OAUTH_REDIRECT_BASE_URL=""

# Optional AI Provider Configuration (Native Fetch Bridge)
provider_url=""
provider_bearer=""

# Chronos v2.1.0 Cryptographic Identity, Secrets Vault & Session Keys
CHRONOS_AUTH_PEPPER_V1=""
CHRONOS_AUTH_PEPPER_V2=""
CHRONOS_MASTER_KEK=""
CHRONOS_SESSION_SECRET=""
CHRONOS_SECURITY_STRICT="false"
